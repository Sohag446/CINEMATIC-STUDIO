{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cinematic Studio",
  "version": "4.0.0",
  "identifier": "com.cinematic.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CINEMATIC STUDIO",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' asset: http://asset.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Md. Sohag Hossen",
    "copyright": "Copyright © 2026 Md. Sohag Hossen. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/installer-hooks.nsh"
      },
      "wix": {
        "language": "en-US",
        "upgradeCode": "e72dd6a0-9d3f-5fea-9cdf-164c9e5e6547"
      }
    }
  }
}

